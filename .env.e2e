# Ambiente da suíte end-to-end.
#
# Idêntico ao .env de desenvolvimento, exceto pelo provedor de pagamento:
# a suíte precisa aprovar o Pix de forma determinística, e o Asaas recusa
# aprovação manual — corretamente, para que ninguém marque cobrança real
# como paga por endpoint interno.
#
# Uso: podman compose --env-file .env.e2e up -d --build
#
# O caminho Asaas continua sendo validado pelo roteiro manual de homologação.

POSTGRES_DB=event_access
POSTGRES_USER=event_access
POSTGRES_PASSWORD=event_access
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/event_access
SPRING_DATASOURCE_USERNAME=event_access
SPRING_DATASOURCE_PASSWORD=event_access

# Segredos descartáveis: este arquivo nunca deve ser usado fora de teste local.
JWT_SECRET=e2e-only-secret-e2e-only-secret-e2e-only-secret
QR_SECRET=e2e-only-qr-secret-e2e-only-qr-secret-e2e-only
DATA_ENCRYPTION_SECRET=e2e-only-encryption-secret-e2e-only-encrypt

APP_ENVIRONMENT=development
APP_BASE_URL=http://localhost:4200
BACKEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# A única linha que realmente muda em relação ao .env de desenvolvimento.
PAYMENT_PROVIDER=FAKE

# Mantidos para o contexto do Spring subir; não são usados com o provedor FAKE.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=nao-utilizado-com-provedor-fake-0000000000
ASAAS_WEBHOOK_TOKEN=nao-utilizado-com-provedor-fake-00000000000000000
ASAAS_USER_AGENT=event-access-platform/1.0-e2e
ASAAS_SANDBOX=true
