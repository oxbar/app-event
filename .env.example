POSTGRES_DB=event_access
POSTGRES_USER=event_access
POSTGRES_PASSWORD=event_access
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/event_access
SPRING_DATASOURCE_USERNAME=event_access
SPRING_DATASOURCE_PASSWORD=event_access
JWT_SECRET=change-this-secret-change-this-secret-change-this-secret
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
QR_SECRET=change-this-qr-secret-change-this-qr-secret-change-this
DATA_ENCRYPTION_SECRET=change-this-data-encryption-secret-change-this
PAYMENT_PROVIDER=FAKE
# Para ativar o Asaas Sandbox, altere para ASAAS e preencha os campos abaixo.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=change-this-asaas-webhook-token-32-characters
ASAAS_USER_AGENT=event-access-platform/1.0
ASAAS_SANDBOX=true
APP_ENVIRONMENT=development
APP_BASE_URL=http://localhost:4200
BACKEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
PUBLIC_RATE_LIMIT_MAX=60
PUBLIC_RATE_LIMIT_WINDOW=60

# Recuperação de senha por e-mail (SMTP).
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@eventaccess.local
